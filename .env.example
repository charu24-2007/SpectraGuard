# SpectraGuard Environment Configuration Example
# Copy to .env and adjust as necessary

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dataset Path (RadioML 2018.01A HDF5)
DATASET_PATH=data/raw/RadioML2018/GOLD_XYZ_OSC.0001_1024.hdf5

# Model Checkpoints Directory
MODELS_DIR=outputs/models

# Default Active Model (ResNet1D, SpectraNet, CNN)
DEFAULT_MODEL=ResNet1D

# Database Path
SPECTRAGUARD_DB_PATH=backend/database/spectraguard.db
